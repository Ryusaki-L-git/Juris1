# =============================================================================
# JURIS configuration template
# Copy to .env for local development. NEVER commit .env.
# =============================================================================

JURIS_ENV=development
JURIS_DEBUG=false
JURIS_API_PREFIX=
JURIS_ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:8080

# Authentication
# development: dev tokens/fallback are allowed only when explicitly enabled.
# staging/production: Firebase verification is mandatory.
JURIS_AUTH_MODE=firebase
JURIS_DEV_ALLOW_UNAUTHENTICATED=false
JURIS_FIREBASE_PROJECT_ID=

# Default AI gateway. echo requires no credentials and makes no AI calls.
# Options: echo | gemini | openai_compatible
JURIS_GATEWAY=echo
JURIS_MODEL_TIMEOUT=60
JURIS_MAX_TOOL_ROUNDS=5

# Managed Gemini
JURIS_GEMINI_API_KEY=
JURIS_GEMINI_MODEL=gemini-3.8-flash

# Managed OpenAI-compatible
JURIS_OPENAI_API_KEY=
JURIS_OPENAI_MODEL=gpt-5.6
JURIS_OPENAI_BASE_URL=https://api.openai.com/v1

# Managed Hugging Face Router (OpenAI-compatible)
JURIS_HUGGINGFACE_API_KEY=
JURIS_HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
JURIS_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Self-hosted OpenAI-compatible model endpoint
JURIS_LOCAL_MODEL=local-model
JURIS_LOCAL_MODEL_BASE_URL=http://127.0.0.1:1234/v1

# Product BYOK. Keep disabled until Firebase + encryption key are configured.
JURIS_BYOK_ENABLED=false
JURIS_CREDENTIAL_ENCRYPTION_KEY=

# LED / Firebase data access
# JURIS reads authorized LED case data. It does not own a parallel case DB.
JURIS_LED_API_URL=

# Monitoring
JURIS_MONITORING_ENABLED=false
JURIS_MONITOR_INTERVAL_MINUTES=180
JURIS_MONITOR_MAX_CONSECUTIVE_FAILURES=5
JURIS_MONITOR_BATCH_SIZE=25

# Managed Gemini usage billing. Credits are separate from eCourts Case Tokens.
# Gross margin is a percentage of customer price (40 means cost / 0.60).
JURIS_AI_USAGE_BILLING_ENABLED=true
JURIS_AI_USD_TO_INR_RATE=95
JURIS_AI_GROSS_MARGIN_PERCENT=40
JURIS_AI_MAX_OUTPUT_TOKENS=2048
JURIS_AI_RESERVATION_BUFFER=1.25
# Optional JSON object of per-model overrides; omitted models use reviewed defaults.
# Example: {"gemini-3.8-flash":{"input_usd_per_million":0.75,"output_usd_per_million":3.75}}
JURIS_AI_MODEL_PRICING_JSON=

# Token pricing (0 means no charge until product pricing is finalized)
JURIS_CASE_TOKEN_COST_ECOURTS_LOOKUP=0
JURIS_CASE_TOKEN_COST_ECOURTS_REFRESH=0
JURIS_CASE_TOKEN_COST_MONITOR_CREATE=0

# Controlled retrieval from code-reviewed official-source URLs only.
# Initial live coverage: Supreme Court of India's Chief Justice and Judges page.
JURIS_OFFICIAL_RESEARCH_ENABLED=true
JURIS_OFFICIAL_RESEARCH_TIMEOUT_SECONDS=8
